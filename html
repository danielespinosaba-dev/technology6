    this.render();
  }
  reset() { this.state = newState(this.setup); this.render(); }
  P(x, y) { return [x + W, H - y]; }
  render() {
    const s = this.state, st = this.setup;
    let g = "";
    if (st.backdropColor) g += `<rect width="480" height="360" fill="${st.backdropColor}"/>`;
    if (st.grid) {
      for (let x = -200; x <= 200; x += 50) { const [px] = this.P(x, 0); g += `<line x1="${px}" y1="0" x2="${px}" y2="360" stroke="${x === 0 ? "#9AA7B8" : (x % 100 ? "#EEF2F7" : "#DCE3EC")}" stroke-width="${x === 0 ? 2 : 1}"/>`; }
      for (let y = -150; y <= 150; y += 50) { const [, py] = this.P(0, y); g += `<line x1="0" y1="${py}" x2="480" y2="${py}" stroke="${y === 0 ? "#9AA7B8" : (y % 100 ? "#EEF2F7" : "#DCE3EC")}" stroke-width="${y === 0 ? 2 : 1}"/>`; }
      for (let x = -200; x <= 200; x += 100) if (x) { const [px, py] = this.P(x, 0); g += `<text x="${px}" y="${py + 16}" font-size="13" text-anchor="middle" fill="#5B6878" font-family="JetBrains Mono,monospace">${x}</text>`; }
      for (let y = -100; y <= 100; y += 100) if (y) { const [px, py] = this.P(0, y); g += `<text x="${px + 6}" y="${py + 4}" font-size="13" fill="#5B6878" font-family="JetBrains Mono,monospace">${y}</text>`; }
      g += `<text x="472" y="${H - 6}" font-size="14" text-anchor="end" fill="#18222F" font-weight="700" font-family="JetBrains Mono,monospace">x</text>`;
      g += `<text x="${W + 8}" y="16" font-size="14" fill="#18222F" font-weight="700" font-family="JetBrains Mono,monospace">y</text>`;
    }
    for (const mk of (st.markers || [])) {
      const [px, py] = this.P(mk.x, mk.y);
      if (mk.kind === "goal") g += `<g transform="translate(${px},${py})"><line x1="0" y1="30" x2="0" y2="-30" stroke="#18222F" stroke-width="3"/><path d="M0 -30h26l-6 9 6 9H0z" fill="#E6503C"/><text x="4" y="46" font-size="13" font-family="Lexend,sans-serif" fill="#18222F">meta</text></g>`;
      else if (mk.kind === "star") g += `<g transform="translate(${px},${py})"><path d="M0-16 4.7-5.5 16-5 7 2.5 10 14 0 7.5-10 14-7 2.5-16-5-4.7-5.5z" fill="#F2B705" stroke="#B58700"/></g>`;
      else g += `<g transform="translate(${px},${py})"><circle r="17" fill="#fff" stroke="#2D44B5" stroke-width="3" stroke-dasharray="5 4"/><text y="7" font-size="20" text-anchor="middle" font-weight="800" fill="#2D44B5" font-family="Baloo 2,sans-serif">${mk.label}</text></g>`;
    }
    if (s.trail && s.trail.length > 1) g += `<polyline points="${s.trail.map(p => this.P(...p).join(",")).join(" ")}" fill="none" stroke="#2D44B5" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>`;
    for (const c of this.clicks) { const [px, py] = this.P(c.x, c.y); g += `<g transform="translate(${px},${py})"><circle r="9" fill="#F28C28" stroke="#fff" stroke-width="3"/><text y="-14" font-size="13" text-anchor="middle" font-weight="700" fill="#F28C28" font-family="Lexend,sans-serif">${c.label || ""}</text></g>`; }
    if (!st.hideSprite) {
      const [px, py] = this.P(s.x, s.y), sc = s.size / 100;
      let tf = `translate(${px},${py}) `;
      if (s.rot === "lr") tf += `scale(${s.dir < 0 ? -sc : sc},${sc})`;
      else tf += `rotate(${s.dir - 90}) scale(${sc})`;
      g += `<g class="spr" transform="${tf}" style="filter:hue-rotate(${(s.effect * 1.8) % 360}deg)">${robotSVG(s.costume)}</g>`;
      if (s.say) {
        const tw = Math.max(50, s.say.length * 9 + 20), bx = Math.min(470 - tw, px + 20), by = Math.max(4, py - 30 * sc - 44);
        g += `<g><rect x="${bx}" y="${by}" width="${tw}" height="34" rx="12" fill="#fff" stroke="#9AA7B8" stroke-width="2"/><text x="${bx + tw / 2}" y="${by + 22}" text-anchor="middle" font-size="15" fill="#18222F" font-family="Lexend,sans-serif">${s.say.replace(/[<&]/g, "")}</text></g>`;
      }
    }
    this.svg.innerHTML = g;
    if (this.onRender) this.onRender(s);
  }
  toStage(evt) {
    const r = this.svg.getBoundingClientRect();
    return { x: Math.round((evt.clientX - r.left) / r.width * 480 - W), y: Math.round(H - (evt.clientY - r.top) / r.height * 360) };
  }
}

/* corre scripts animados en un escenario */
class Runner {
  constructor(stage, getScripts) { this.stage = stage; this.getScripts = getScripts; this.ctx = null; this.log = []; }
  async fire(event, fresh) {
    if (fresh) { this.stop(); this.stage.reset(); }
    const scripts = this.getScripts().filter(sc => sc[0] && sc[0].op === hatFor(event));
    this.log.push(event);
    if (this.onFire) this.onFire(event);
    if (!scripts.length) return;
    const ctx = this.ctx = { stopped: false, foreverCap: 2000, render: () => this.stage.render(), tick: () => sleep(90), sleep: secs => sleep(Math.min(secs, 4) * 1000) };
    await Promise.all(scripts.map(sc => execList(sc.slice(1), this.stage.state, ctx)));
    this.stage.render();
    if (this.onDone) this.onDone(this.stage.state);
  }
  stop() { if (this.ctx) this.ctx.stopped = true; if (this.stage.state) { this.stage.state.say = null; this.stage.render(); } }
}

function stageBox(stage, runner, { controls = true, readout = false } = {}) {
  const box = el("div", { class: "stagebox" });
  if (controls) {
    const ctl = el("div", { class: "stagectl" },
      el("button", { type: "button", title: "Bandera verde", "aria-label": "Iniciar con la bandera verde", html: FLAG_SVG.replace('class="flagico"', 'width="26" height="26"'), onclick: () => runner.fire("flag", true) }),
      el("button", { type: "button", title: "Detener", "aria-label": "Detener", html: STOP_SVG.replace('class="flagico"', 'width="24" height="24"'), onclick: () => runner.stop() }));
    if (readout) {
      const ro = el("span", { class: "readout" });
      stage.onRender = s => ro.textContent = `x: ${Math.round(s.x)}   y: ${Math.round(s.y)}   dirección: ${Math.round(s.dir)}`;
      ctl.append(ro); stage.render();
    }
    box.append(ctl);
  }
  box.append(stage.svg);
  return box;
}

/* ---------------------- tipos de reactivo ---------------------- */
const TYPES = {};

/* opción múltiple, opcionalmente con programas que se pueden ejecutar */
TYPES.choice = {
  render(it, host, st) {
    const opts = el("div", { class: "options" });
    it.options.forEach((o, i) => {
      const b = el("button", { type: "button", class: "opt", "aria-pressed": st.answer === i ? "true" : "false" },
        el("span", { class: "letter" }, "abc"[i] || String(i + 1)));
