/* armar o corregir un programa y probarlo */
TYPES.build = {
  render(it, host, st) {
    st.scripts = st.scripts || clone(it.start || [[]]);
    st.tries = st.tries || 0;
    const stage = new Stage(it.stage || {});
    const runner = new Runner(stage, () => st.scripts);
    st.log = st.log || [];
    const tipBox = el("div", { class: "tipbox", hidden: "" });
    const tipCount = {};
    const showTip = text => { tipBox.innerHTML = ""; tipBox.append(el("strong", {}, "Pista"), el("span", {}, text)); tipBox.hidden = false; };
    runner.onFire = ev => {
      st.log.push(ev);
      if (ev !== "flag") return;
      st.tries++;
      tipBox.hidden = true;
      clearTimeout(st.tipTimer);
      st.tipTimer = setTimeout(async () => {
        if (it.flagTips) { showTip(it.flagTips[Math.min(st.tries, it.flagTips.length) - 1]); return; }
        const res = await simulate(st.scripts, it.stage || {});
        const ci = it.checks.findIndex(c => !c.fn(res, st.scripts, st));
        if (ci < 0 || !it.checks[ci].tips) return;
        tipCount[ci] = (tipCount[ci] || 0) + 1;
        const tips = it.checks[ci].tips;
        showTip(tips[Math.min(tipCount[ci], tips.length) - 1]);
      }, 1400);
    };
    st.cleanup = () => { runner.stop(); clearTimeout(st.tipTimer); };
    const editable = !!it.palette;
    let active = null;
    const slots = {
      make(arr, label) {
        const b = el("button", { type: "button", class: "slot" + (active === arr ? " active" : "") }, "+ " + label);
        b.onclick = () => { active = arr; draw(); };
        return b;
      }
    };
    const scriptHost = el("div", { class: "scripts-row" });
    const heads = new Map(), zones = new Map();
    let pal = null;

    /* ---- arrastrar y soltar ---- */
    const contains = (blk, list) => !!blk.body && (blk.body === list || blk.body.some(x => contains(x, list)));
    const isHat = b => DEFS[b.op].hat;
    const marker = el("div", { class: "dropline", hidden: "" });
    let drag = null, justDragged = false;
    const findTarget = (x, y) => {
      const hit = document.elementFromPoint(x, y);
      if (!hit) return null;
      if (drag.from === "script" && pal && hit.closest(".palette")) return { del: true };
      if (!progPanel.contains(hit)) return null;
      const head = hit.closest(".blk");
      if (head && heads.has(head)) {
        const info = heads.get(head), r = head.getBoundingClientRect();
        if (y < r.top + r.height / 2 && !isHat(info.block)) return { list: info.list, index: info.index, y: r.top, x: r.left };
        if (info.isC) return { list: info.block.body, index: 0, y: r.bottom, x: r.left + 16 };
        return { list: info.list, index: info.index + 1, y: r.bottom, x: r.left };
      }
      const zone = [...zones.keys()].find(z => z.contains(hit) && (hit === z || !hit.closest(".blk")));
      if (zone) { const z = zones.get(zone), r = zone.getBoundingClientRect(); return { list: z.list, index: z.index(), y: z.inset ? r.bottom - 4 : r.bottom, x: r.left + (z.inset || 0) }; }
      const box = hit.closest(".script") || scriptHost.querySelector(".script");
      if (box) { const main = st.scripts[0], last = [...box.children].filter(c => c.matches(".blk,.cblk")).pop(); const r = (last || box).getBoundingClientRect(); return { list: main, index: main.length, y: last ? r.bottom : r.top + 8, x: r.left }; }
      return null;
    };
    const startDrag = (e, src) => {
      if (e.button !== 0 || e.target.closest("input,button")) return;
      const x0 = e.clientX, y0 = e.clientY;
      const r = src.node.getBoundingClientRect();
      const move = ev => {
        if (!drag) {
          if (Math.hypot(ev.clientX - x0, ev.clientY - y0) < 6) return;
          drag = { ...src, dx: x0 - r.left, dy: y0 - r.top, target: null };
          drag.ghost = src.node.cloneNode(true);
          drag.ghost.classList.add("dragghost");
          drag.ghost.style.width = r.width + "px";
          document.body.append(drag.ghost);
          if (src.from === "script") src.node.classList.add("dragsrc");
          document.body.classList.add("dragging");
        }
        ev.preventDefault();
        drag.ghost.style.left = (ev.clientX - drag.dx) + "px";
        drag.ghost.style.top = (ev.clientY - drag.dy) + "px";
        const t = drag.target = findTarget(ev.clientX, ev.clientY);
        if (pal) pal.classList.toggle("trash", !!(t && t.del));
        if (t && !t.del) { marker.hidden = false; marker.style.left = t.x + "px"; marker.style.top = (t.y - 2) + "px"; }
        else marker.hidden = true;
      };
      const up = () => {
        window.removeEventListener("pointermove", move);
        window.removeEventListener("pointerup", up);
        window.removeEventListener("pointercancel", up);
        if (!drag) return;
        const d = drag; drag = null;
        d.ghost.remove(); marker.hidden = true; document.body.classList.remove("dragging");
        if (pal) pal.classList.remove("trash");
        d.node.classList.remove("dragsrc");
        justDragged = true; setTimeout(() => justDragged = false, 50);
        drop(d, d.target);
      };
      window.addEventListener("pointermove", move);
      window.addEventListener("pointerup", up);
      window.addEventListener("pointercancel", up);
    };
    const drop = (d, t) => {
      if (!t) return;
      const main = st.scripts[0];
      if (t.del) { d.info.list.splice(d.info.index, 1); draw(true); return; }
      const blk = d.from === "palette" ? clone(d.tpl) : d.info.block;
      if (d.from === "script" && contains(blk, t.list)) return;
      let idx = t.index;
      if (d.from === "script") { d.info.list.splice(d.info.index, 1); if (d.info.list === t.list && d.info.index < idx) idx--; }
      if (isHat(blk)) { if (main[0] && isHat(main[0])) main[0] = blk; else main.unshift(blk); }
      else {
        if (t.list === main && idx === 0 && main[0] && isHat(main[0])) idx = 1;
        t.list.splice(idx, 0, blk);
      }
      draw(true);
    };

    const draw = (structural) => {
      if (structural) runner.stop();
      scriptHost.innerHTML = ""; heads.clear(); zones.clear();
      const ctxBase = {
        onChange: draw, slots,
        reg: (head, node, info) => { heads.set(head, info); head.classList.add("grab"); head.addEventListener("pointerdown", e => startDrag(e, { from: "script", node, info })); },
        regZone: (zone, z) => zones.set(zone, z)
      };
      st.scripts.forEach((sc, si) => {
        const box = el("div", { class: "script" });
        if (it.labels) box.append(el("strong", { style: "font-family:var(--display);font-size:20px" }, it.labels[si]));
        if (!active || !inTree(st.scripts, active)) active = st.scripts[0];
        sc.forEach((b, i) => box.append(renderBlock(b, editable ? "edit" : "locked", { ...ctxBase, parent: sc, index: i })));
        if (editable) box.append(slots.make(sc, sc.length ? "agregar al final" : "arrastra aquí tu primer bloque"));
        scriptHost.append(box);
      });
      if (it.labels) scriptHost.querySelectorAll(".script").forEach(b => b.style.minHeight = "0");
    };
    const inTree = (lists, target) => lists.some(l => l === target || l.some(b => b.body && inTree([b.body], target)));
    draw();
    const work = el("div", { class: "work" + (editable ? "" : " noPalette") });
    if (editable) {
      pal = el("div", { class: "palette" });
      it.palette.forEach(tpl => {
        const node = renderBlock(tpl, "palette");
        node.classList.add("grab");
        node.addEventListener("pointerdown", e => startDrag(e, { from: "palette", node, tpl }));
        node.addEventListener("click", () => {
          if (justDragged) return;
          const nb = clone(tpl);
          if (isHat(nb)) { const main = st.scripts[0]; if (main[0] && isHat(main[0])) main[0] = nb; else main.unshift(nb); }
          else (active || st.scripts[0]).push(nb);
          draw(true);
        });
        pal.append(node);
      });
      work.append(el("div", { class: "panel" }, el("div", { class: "panel-title" }, "Bloques"), pal));
    }
    const progPanel = el("div", { class: "panel" }, el("div", { class: "panel-title" }, editable ? "Área de programación" : (JSON.stringify(it.start).includes('"edit"') ? "Programa (cambia el número con borde punteado)" : "Programas")), scriptHost);
    if (editable) progPanel.append(el("p", { class: "qhint", style: "margin:10px 0 0" }, "Arrastra los bloques hasta aquí, como en Scratch. Para meter un bloque en «repetir» o «por siempre», suéltalo justo debajo de su parte de arriba. Para quitar un bloque, arrástralo de regreso a la columna de bloques."));
    work.append(progPanel, el("div", { class: "panel" }, el("div", { class: "panel-title" }, "Escenario"), stageBox(stage, runner, { readout: it.readout })));
    progPanel.append(tipBox);
    document.body.append(marker);
    const prevCleanup = st.cleanup; st.cleanup = () => { prevCleanup(); marker.remove(); };
    if (it.events) {
      stage.svg.addEventListener("click", e => { if (e.target.closest(".spr")) runner.fire("click", false); });
      st.keyHandler = e => { if (e.code === "Space") { e.preventDefault(); runner.fire("key", false); } };
      st.keyUp = e => { if (e.code === "Space") e.preventDefault(); };
      window.addEventListener("keydown", st.keyHandler);
      window.addEventListener("keyup", st.keyUp);
      const prev = st.cleanup; st.cleanup = () => { prev(); window.removeEventListener("keydown", st.keyHandler); window.removeEventListener("keyup", st.keyUp); };
    }
    host.append(work);
  },
  answered: () => true,
  async evaluate(it, st) {
    const res = await simulate(st.scripts, it.stage || {});
    st.passed = it.checks.map(c => !!c.fn(res, st.scripts, st));
    st.review = { programa: clone(st.scripts), log: (st.log || []).slice(), checks: it.checks.map((c, i) => ({ desc: c.desc, ok: st.passed[i] })) };
    return st.passed.filter(Boolean).length;
  },
  max: it => it.checks.length,
  describe: (it, st) => scriptText(st.scripts || []) + "  [pruebas con bandera: " + (st.tries || 0) + "]"
};

