    tools.append(el("button", { type: "button", title: "Quitar", "aria-label": "Quitar bloque", onclick: e => { e.stopPropagation(); ctx.parent.splice(ctx.index, 1); ctx.onChange(true); } }, "✕"));
    head.append(tools);
