/* ---------------------- flujo del examen ---------------------- */
let S = null; // estado de la sesión
let examActive = false;
let lastIncident = 0;

function totalMax() { return ITEMS.reduce((a, it) => a + maxOf(it), 0); }
function maxOf(it) { const T = TYPES[it.type]; return T.max ? T.max(it) : (it.points || 1); }

function showView(id) { ["startView", "examView", "resultView"].forEach(v => $("#" + v).hidden = v !== id); }

function save() { store.set({ nombre: S.nombre, grupo: S.grupo, idx: S.idx, results: S.results, salidas: S.salidas, salidasLog: S.salidasLog || [], desbloqueos: S.desbloqueos || 0, inicio: S.inicio, fin: S.fin || null, terminado: S.terminado || false }); }

function startExam(resume) {
  showView("examView");
  examActive = true;
  renderItem();
  goFullscreen();
}
function renderItem() {
  const it = ITEMS[S.idx];
  const host = $("#itemHost"); host.innerHTML = "";
  S.cur = {};
  $("#who").innerHTML = "";
  $("#who").append(S.nombre, " ", el("small", {}, `· ${GRADO}° ${S.grupo}`));
  const dots = $("#dots"); dots.innerHTML = "";
  ITEMS.forEach((_, i) => dots.append(el("span", { class: i < S.idx ? "done" : i === S.idx ? "now" : "" })));
  host.append(el("div", { class: "qhead" }, el("span", { class: "qnum" }, `${S.idx + 1} de ${ITEMS.length}`), el("h2", {}, it.prompt)));
  if (it.hint) host.append(el("p", { class: "qhint" }, it.hint));
  TYPES[it.type].render(it, host, S.cur);
  $("#btnNext").textContent = S.idx === ITEMS.length - 1 ? "Terminar examen" : "Siguiente";
  $("#footNote").textContent = "";
  window.scrollTo(0, 0);
  if (document.activeElement) document.activeElement.blur();
}
async function next() {
  const it = ITEMS[S.idx], T = TYPES[it.type];
  if (!T.answered(it, S.cur)) { $("#footNote").textContent = "Contesta este reactivo antes de continuar."; return; }
  if (S.idx === ITEMS.length - 1 && $("#confirmOverlay").hidden) { $("#confirmOverlay").hidden = false; return; }
  $("#confirmOverlay").hidden = true;
  if (S.cur.cleanup) S.cur.cleanup();
  const pts = T.evaluate ? await T.evaluate(it, S.cur) : T.score(it, S.cur);
  S.results[S.idx] = { id: it.id, tema: it.tema, puntos: pts, max: maxOf(it), respuesta: T.describe(it, S.cur) };
  if (S.cur.review) Object.assign(S.results[S.idx], S.cur.review);
  S.idx++;
  save();
  if (S.idx >= ITEMS.length) finish(); else renderItem();
}
function finish() {
  examActive = false;
  if (!S.terminado) { S.terminado = true; S.fin = Date.now(); save(); }
  renderResult();
}
const fmtFecha = t => new Date(t).toLocaleDateString("es-MX", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
const fmtHora = t => new Date(t).toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit" });
function renderResult() {
  const ac = S.results.reduce((a, r) => a + r.puntos, 0), tot = totalMax();
  const cal = Math.round(ac / tot * 100) / 10;
  showView("resultView");
  $("#resName").textContent = S.nombre;
  $("#resMeta").textContent = `${GRADO}° grupo ${S.grupo} · ${fmtFecha(S.fin)} · de ${fmtHora(S.inicio)} a ${fmtHora(S.fin)} (${Math.max(1, Math.round((S.fin - S.inicio) / 60000))} min)`;
  $("#resScore").innerHTML = `${cal}<small> / 10</small>`;
  $("#resAciertos").textContent = `${ac} de ${tot} aciertos`;
  const ex = $("#resExits"); ex.innerHTML = "";
  ex.className = "rexits " + (S.salidas ? "dirty" : "clean");
  ex.append(el("div", { class: "n" }, String(S.salidas)), el("div", { class: "lbl" }, S.salidas === 1 ? "salida de la pantalla del examen" : "salidas de la pantalla del examen"));
  if (S.salidasLog && S.salidasLog.length) ex.append(el("ul", {}, S.salidasLog.map(x => el("li", {}, `${fmtHora(x.t)} · ${x.tipo}`))));
  else ex.append(el("div", { style: "font-size:14px" }, "No salió de pantalla completa ni cambió de pestaña."));
  if (S.desbloqueos) ex.append(el("div", { style: "font-size:14px;font-weight:600" }, `La maestra desbloqueó el examen ${S.desbloqueos} ${S.desbloqueos === 1 ? "vez" : "veces"}.`));
  const tb = $("#resTable"); tb.innerHTML = "";
  tb.append(el("tr", {}, el("th", {}, "#"), el("th", {}, "Tema"), el("th", { style: "text-align:right" }, "Puntos")));
  S.results.forEach((r, i) => tb.append(el("tr", {}, el("td", {}, String(i + 1)), el("td", {}, r.tema),
    el("td", { class: "pts" + (r.puntos === r.max ? " full" : r.puntos === 0 ? " zero" : "") }, `${r.puntos} / ${r.max}`))));
  const rv = $("#review"); rv.innerHTML = "";
  const built = S.results.map((r, i) => ({ r, i, it: ITEMS[i] })).filter(x => x.it && x.it.type === "build");
  if (!built.length) return;
  rv.append(el("h3", {}, "Revisión de los programas"), el("p", { class: "rv-note" }, "Para cada reactivo de programación: lo que armó el alumno, un programa que cumple lo pedido y qué requisitos se cumplieron."));
  built.forEach(({ r, i, it }) => {
    const col = (title, scripts, text) => {
      const c = el("div", { class: "rv-col" }, el("div", { class: "panel-title" }, title));
      if (text) c.append(el("p", { style: "margin:0" }, text));
      else clone(scripts || []).map(function strip(l) { return l.map(b => { delete b.edit; if (b.body) strip(b.body); return b; }); }).forEach(sc => { const box = el("div", { class: "script rv-script" }); sc.forEach(b => box.append(renderBlock(b, "locked"))); if (!sc.length) box.append(el("span", { class: "rv-empty" }, "(vacío)")); c.append(box); });
      return c;
    };
    const checks = el("ul", { class: "rv-checks" }, (r.checks || []).map(c => el("li", { class: c.ok ? "ok" : "no" }, (c.ok ? "✓ " : "✗ ") + c.desc)));
    rv.append(el("div", { class: "rv-item" },
      el("div", { class: "rv-head" }, el("strong", {}, `${i + 1}. ${r.tema}`), el("span", { class: "pts" + (r.puntos === r.max ? " full" : r.puntos === 0 ? " zero" : "") }, `${r.puntos} / ${r.max}`)),
      el("div", { class: "rv-cols" }, col(it.labels ? "Pruebas del alumno" : "Programa del alumno", it.labels ? null : (r.programa || []), it.labels ? "Usó: " + ([...new Set((r.log || []).map(e => ({ flag: "bandera verde", key: "tecla espacio", click: "clic en el robot" })[e]))].join(", ") || "nada") : null),
        col(it.solutionText ? "Respuesta esperada" : "Programa esperado", it.solution, it.solutionText || null)),
      checks));
  });
}

/* ---------------------- pantalla completa y salidas ---------------------- */
const docEl = document.documentElement;
let fsSupported = !!(docEl.requestFullscreen || docEl.webkitRequestFullscreen);
const fsElement = () => document.fullscreenElement || document.webkitFullscreenElement || null;
function goFullscreen() {
  if (!fsSupported) return;
  try {
    const r = docEl.requestFullscreen ? docEl.requestFullscreen() : docEl.webkitRequestFullscreen();
    if (r && typeof r.catch === "function") r.catch(() => { fsSupported = false; });
  } catch (e) { fsSupported = false; }
}
function incident(kind) {
  if (!examActive) return;
  const now = Date.now(); if (now - lastIncident < 1500) return; lastIncident = now;
  S.salidas++; (S.salidasLog = S.salidasLog || []).push({ t: now, tipo: kind }); save();
  if (S.salidas >= MAX_SALIDAS && !MODO_PRUEBA) { $("#leaveOverlay").hidden = true; $("#lockOverlay").hidden = false; $("#unlockCode").value = ""; return; }
  $("#leaveMsg").textContent = MODO_PRUEBA ? `Quedó registrado (${S.salidas}). En modo de prueba el examen no se bloquea.` : `Quedó registrado (${S.salidas} de ${MAX_SALIDAS}). A la salida número ${MAX_SALIDAS}, el examen se bloquea y necesitarás a tu maestra.`;
  $("#leaveOverlay").hidden = false;
}
["fullscreenchange", "webkitfullscreenchange"].forEach(t => document.addEventListener(t, () => { if (!fsElement() && fsSupported) incident("salió de pantalla completa"); }));
document.addEventListener("visibilitychange", () => { if (document.hidden) incident("cambió de pestaña"); });
$("#btnBack").onclick = () => { $("#leaveOverlay").hidden = true; goFullscreen(); };
$("#btnUnlock").onclick = () => {
  if ($("#unlockCode").value.trim().toLowerCase() !== CODIGO_DOCENTE.toLowerCase() && !MODO_PRUEBA) { $("#unlockErr").textContent = "Código incorrecto."; return; }
  $("#unlockErr").textContent = ""; $("#lockOverlay").hidden = true; S.desbloqueos = (S.desbloqueos || 0) + 1; save(); lastIncident = Date.now(); goFullscreen();
};
document.addEventListener("contextmenu", e => { if (examActive) e.preventDefault(); });
["copy", "cut", "paste"].forEach(t => document.addEventListener(t, e => { if (examActive && !(e.target.closest && e.target.closest("input"))) e.preventDefault(); }));
window.addEventListener("beforeunload", e => { if (examActive) { e.preventDefault(); e.returnValue = ""; } });

/* ---------------------- inicio ---------------------- */
function init() {
if (MODO_PRUEBA) {
  ["#resumeCode", "#newExamCode"].forEach(sel => { const x = $(sel); if (x) x.hidden = true; });
  const rf = $("#resumeForm p"); if (rf) rf.innerHTML = 'Hay un examen sin terminar de <strong id="resumeName"></strong>. Puedes continuarlo o empezar de nuevo.';
}
let grupo = null;
$("#btnStart").onclick = () => {
  const nombre = $("#nombre").value.trim().replace(/\s+/g, " ");
  const showErr = m => { const e = $("#startErr"); e.textContent = m; e.classList.add("show"); e.scrollIntoView({ block: "center", behavior: "smooth" }); };
  $("#startErr").classList.remove("show"); $("#startErr").textContent = "";
  if (nombre.split(" ").length < 2) { showErr("Escribe tu apellido y tu nombre (al menos dos palabras)."); $("#nombre").focus(); return; }
  const gsel = document.querySelector('input[name="grupo"]:checked'); grupo = gsel ? gsel.value : null;
  if (!grupo) { showErr("Elige tu grupo (A o B)."); return; }
  S = { nombre, grupo, idx: 0, results: [], salidas: 0, inicio: Date.now() };
  save(); startExam();
};
const prev = store.get();
if (prev && !prev.terminado) {
  $("#newForm").hidden = true; $("#resumeForm").hidden = false; $("#resumeName").textContent = prev.nombre;
  const ok = () => { if ($("#resumeCode").value.trim().toLowerCase() !== CODIGO_DOCENTE.toLowerCase() && !MODO_PRUEBA) { $("#resumeErr").textContent = "Código incorrecto."; return false; } return true; };
  $("#btnResume").onclick = () => { if (!ok()) return; S = prev; startExam(true); };
  $("#btnRestart").onclick = () => { if (!ok()) return; store.clear(); $("#resumeForm").hidden = true; $("#newForm").hidden = false; };
} else if (prev && prev.terminado && prev.results) {
  S = prev; renderResult();
}
$("#btnNewExam").onclick = () => { $("#newExamBox").hidden = false; $("#newExamCode").focus(); };
$("#btnNewExamGo").onclick = () => {
  if ($("#newExamCode").value.trim().toLowerCase() !== CODIGO_DOCENTE.toLowerCase() && !MODO_PRUEBA) { $("#newExamErr").textContent = "Código incorrecto."; return; }
  store.clear(); location.reload();
};
$("#btnNext").onclick = next;
$("#btnFinish").onclick = next;
$("#btnCancelFinish").onclick = () => $("#confirmOverlay").hidden = true;
}
</script>
<script>
/* =========================== REACTIVOS =========================== */
