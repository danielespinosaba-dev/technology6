const B = (op, ...args) => ({ op, args });
const C = (op, args, body) => ({ op, args, body });
const E = (b, ...idx) => { b.edit = idx; return b; };
function hasInside(scripts, cop, op) {
  const deep = l => l.some(b => b.op === op || (b.body && deep(b.body)));
  const walk = l => l.some(b => (b.op === cop && b.body && deep(b.body)) || (b.body && walk(b.body)));
  return scripts.some(walk);
}

function blockText(b) {
  const d = DEFS[b.op];
  const t = d.parts.map(p => typeof p === "number" ? (b.args[p] ?? "") : p === "FLAG" ? "bandera verde" : String(p).replace("@", "")).join(" ");
  return b.body ? t + " { " + b.body.map(blockText).join("; ") + " }" : t;
}
function scriptText(scripts) { return scripts.map(s => s.map(blockText).join(" → ")).join(" || "); }

/* render: mode = "palette" | "edit" | "locked" ; ctx = {parent, index, onChange, slots} */
function renderBlock(b, mode, ctx = {}) {
  const d = DEFS[b.op];
  const head = el("div", { class: "blk " + d.cat + (d.hat ? " hat" : "") });
  for (const p of d.parts) {
    if (typeof p === "number") {
      const editable = (mode === "edit") || (mode === "locked" && b.edit && b.edit.includes(p));
