}

/* ---------------------- simulador ---------------------- */
const W = 240, H = 180;
function newState(setup = {}) {
  const s = Object.assign({ x: 0, y: 0, dir: 90, size: 100, costume: 0, effect: 0, rot: "all", say: null, backdrop: null }, clone(setup.sprite || {}));
  s.trail = setup.trail ? [[s.x, s.y]] : null;
  s.m = { costumeChanges: 0, effectChanges: 0, dist: 0, bounces: 0, timeline: [], says: [], sizeChanges: 0 };
  return s;
}
function halfW(s) { return 26 * s.size / 100; }
function fence(s) {
  const hw = halfW(s);
  s.x = Math.max(-W + hw, Math.min(W - hw, s.x));
  s.y = Math.max(-H + hw, Math.min(H - hw, s.y));
}
function normDir(d) { d = ((d + 180) % 360 + 360) % 360 - 180; return d === -180 ? 180 : d; }
function moveTo(s, x, y) {
  const ox = s.x, oy = s.y; s.x = x; s.y = y; fence(s);
  s.m.dist += Math.hypot(s.x - ox, s.y - oy);
  if (s.trail) s.trail.push([s.x, s.y]);
  s.m.timeline.push("move");
}

async function execList(list, s, ctx) {
  for (const b of list) { if (ctx.stopped) return; await execBlock(b, s, ctx); }
}
async function execBlock(b, s, ctx) {
  const a = b.args || [];
  switch (b.op) {
    case "move": { const r = (90 - s.dir) * Math.PI / 180; moveTo(s, s.x + num(a[0]) * Math.cos(r), s.y + num(a[0]) * Math.sin(r)); break; }
    case "turn": s.dir = normDir(s.dir + num(a[0])); break;
    case "pointdir": s.dir = normDir(num(a[0])); break;
    case "goto": moveTo(s, num(a[0]), num(a[1])); break;
    case "changex": moveTo(s, s.x + num(a[0]), s.y); break;
    case "changey": moveTo(s, s.x, s.y + num(a[0])); break;
    case "bounce": {
      const hw = halfW(s); let hit = false;
      if (s.x >= W - hw - 0.01 || s.x <= -W + hw + 0.01) { s.dir = normDir(-s.dir); hit = true; }
      if (s.y >= H - hw - 0.01 || s.y <= -H + hw + 0.01) { s.dir = normDir(180 - s.dir); hit = true; }
      if (hit) { s.m.bounces++; s.m.timeline.push("bounce"); }
      break;
    }
    case "rotlr": s.rot = "lr"; break;
    case "sayfor": s.say = String(a[0]); s.m.says.push(String(a[0])); s.m.timeline.push("say"); ctx.render(); await ctx.sleep(num(a[1])); s.say = null; break;
    case "nextcostume": s.costume = (s.costume + 1) % 2; s.m.costumeChanges++; s.m.timeline.push("costume"); break;
    case "coloreffect": s.effect += num(a[0]); s.m.effectChanges++; s.m.timeline.push("effect"); break;
    case "changesize": s.size = Math.max(5, s.size + num(a[0])); s.m.sizeChanges++; break;
    case "setsize": s.size = Math.max(5, num(a[0])); break;
    case "wait": await ctx.sleep(num(a[0])); break;
    case "repeat": { const n = Math.max(0, Math.round(num(a[0]))); for (let i = 0; i < n && !ctx.stopped; i++) { await execList(b.body, s, ctx); await ctx.tick(); } return; }
    case "forever": { let i = 0; while (!ctx.stopped && i++ < ctx.foreverCap) { await execList(b.body, s, ctx); await ctx.tick(); } ctx.stopped = true; return; }
  }
  ctx.render(); await ctx.tick();
}
/* corre sin animación y devuelve el estado final */
async function simulate(scripts, setup, event = "flag") {
  const s = newState(setup);
  const ctx = { stopped: false, foreverCap: 300, render() {}, tick: () => Promise.resolve(), sleep: () => Promise.resolve() };
  await Promise.all(scripts.filter(sc => sc[0] && sc[0].op === hatFor(event)).map(sc => execList(sc.slice(1), s, ctx)));
  return s;
}
function hatFor(ev) { return ev === "flag" ? "whenflag" : ev === "key" ? "whenkey" : "whenclicked"; }

/* ---------------------- escenario (SVG) ---------------------- */
function robotSVG(costume) {
  const legs = costume === 0
    ? '<rect x="-14" y="18" width="8" height="12" rx="3" fill="#0E6E6E"/><rect x="6" y="18" width="8" height="12" rx="3" fill="#0E6E6E"/>'
    : '<rect x="-20" y="16" width="8" height="13" rx="3" fill="#0E6E6E" transform="rotate(25 -16 18)"/><rect x="11" y="16" width="8" height="13" rx="3" fill="#0E6E6E" transform="rotate(-25 15 18)"/>';
  return legs +
    '<line x1="0" y1="-26" x2="0" y2="-34" stroke="#0E6E6E" stroke-width="3"/><circle cx="0" cy="-36" r="4" fill="#F28C28"/>' +
    '<rect x="-22" y="-26" width="44" height="46" rx="12" fill="#17A2A2" stroke="#0E6E6E" stroke-width="2.5"/>' +
    '<rect x="-12" y="-17" width="30" height="16" rx="6" fill="#E9FBFB"/>' +
    '<circle cx="-2" cy="-9" r="3.2" fill="#18222F"/><circle cx="10" cy="-9" r="3.2" fill="#18222F"/>' +
    '<rect x="20" y="0" width="12" height="6" rx="3" fill="#F28C28"/>';
}
class Stage {
  constructor(setup, opts = {}) {
    this.setup = setup; this.opts = opts;
    this.svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    this.svg.setAttribute("viewBox", "0 0 480 360");
    this.svg.setAttribute("class", "stage" + (opts.clickable ? " clickable" : ""));
    this.svg.setAttribute("role", "img");
