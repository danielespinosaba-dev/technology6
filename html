<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Examen práctico de Scratch · 6°</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Lexend:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap">
<style>
/* Layout: barra superior fija + una tarjeta de reactivo por pantalla; en reactivos prácticos, bloques | programa | escenario */
:root{
  --ground:#E9EEF5; --paper:#FFFFFF; --ink:#18222F; --muted:#5B6878; --line:#D3DBE6;
  --accent:#2D44B5; --accent-soft:#E2E7FB; --ok:#1F8A4C; --warn:#C2410C;
  --motion:#4C97FF; --looks:#9966FF; --events:#E6A800; --control:#FFAB19;
  --display:"Baloo 2","Trebuchet MS",system-ui,sans-serif;
  --body:"Lexend","Segoe UI",system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
  color-scheme:light;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{background:var(--ground);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.45;-webkit-user-select:none;user-select:none}
input{user-select:text;-webkit-user-select:text}
button{font:inherit;cursor:pointer}
button:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
[hidden]{display:none!important}
h1,h2,h3{font-family:var(--display);line-height:1.1;margin:0;text-wrap:balance}

/* ---------- inicio ---------- */
.start{min-height:100%;display:grid;place-items:center;padding:24px 16px}
.start-card{background:var(--paper);border-radius:20px;padding:32px;max-width:560px;width:100%;box-shadow:0 10px 30px rgba(24,34,47,.08);display:grid;gap:18px}
.eyebrow{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.start-card h1{font-size:44px;color:var(--accent)}
.field{display:grid;gap:6px}
.field label{font-weight:600}
.field input[type=text]{font:inherit;font-size:19px;padding:12px 14px;border:2px solid var(--line);border-radius:12px;background:var(--paper);color:var(--ink)}
.groups{display:flex;gap:10px}
.gopt{flex:1;position:relative;cursor:pointer}
.gopt input{position:absolute;opacity:0;width:100%;height:100%;inset:0;margin:0;cursor:pointer}
.gopt span{display:block;text-align:center;padding:12px;border:2px solid var(--line);border-radius:12px;background:var(--paper);font-family:var(--display);font-size:24px;font-weight:700;color:var(--ink)}
.gopt input:checked + span{border-color:var(--accent);background:var(--accent);color:#fff}
.gopt input:focus-visible + span{outline:3px solid var(--accent);outline-offset:2px}
.jserr{background:#FDE7D7;color:#7C2D12;border-radius:10px;padding:10px 12px;font-size:14px}
.rules{background:var(--ground);border-radius:12px;padding:14px 16px;font-size:15px;color:var(--muted)}
.rules ul{margin:6px 0 0;padding-left:20px}
.btn{border:0;border-radius:12px;padding:12px 22px;font-family:var(--display);font-weight:700;font-size:21px;background:var(--accent);color:#fff}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn.ghost{background:var(--paper);color:var(--accent);border:2px solid var(--accent)}
.err{color:var(--warn);font-size:15px;min-height:1.2em}
.err.show{background:#FDE7D7;color:#7C2D12;border-radius:10px;padding:10px 12px;font-weight:600}

/* ---------- examen ---------- */
.exam{min-height:100%;display:grid;grid-template-rows:auto 1fr auto}
.topbar{display:flex;align-items:center;gap:16px;padding:10px 20px;background:var(--paper);border-bottom:1px solid var(--line);flex-wrap:wrap}
.topbar .who{font-weight:600}
.topbar .who small{color:var(--muted);font-weight:400}
.dots{display:flex;gap:6px;margin-left:auto}
.dots span{width:12px;height:12px;border-radius:50%;background:var(--line)}
.dots span.done{background:var(--accent)}
.dots span.now{background:var(--paper);box-shadow:0 0 0 3px var(--accent)}
.main{padding:20px;display:grid;gap:16px;align-content:start;max-width:1400px;width:100%;margin:0 auto}
.qhead{display:flex;gap:14px;align-items:baseline}
.qnum{font-family:var(--display);font-size:20px;font-weight:800;color:var(--accent);white-space:nowrap}
.qhead h2{font-size:27px;font-weight:700}
.qhint{color:var(--muted);font-size:15px;margin-top:-8px}
.bottombar{display:flex;justify-content:flex-end;align-items:center;gap:14px;padding:12px 20px;background:var(--paper);border-top:1px solid var(--line)}
.bottombar .note{color:var(--muted);font-size:15px;margin-right:auto}

.panel{background:var(--paper);border-radius:16px;padding:14px;min-width:0}
.panel-title{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:8px}
.work{display:grid;grid-template-columns:minmax(230px,290px) minmax(240px,1fr) minmax(340px,560px);gap:14px;align-items:start}
.work.noPalette{grid-template-columns:minmax(260px,1fr) minmax(360px,600px)}
.hotwork{display:grid;grid-template-columns:minmax(240px,320px) minmax(0,1fr);gap:14px;align-items:start}
@media (max-width:1000px){.hotwork{grid-template-columns:1fr}}
.work.stageOnly{grid-template-columns:minmax(320px,640px);justify-content:center}
@media (max-width:1000px){.work,.work.noPalette{grid-template-columns:1fr}}

/* ---------- bloques ---------- */
.palette{display:grid;gap:8px;justify-items:start}
.palette .blk{cursor:pointer;white-space:normal;flex-wrap:wrap;text-align:left}
.palette .blk:hover{filter:brightness(1.07)}
.script{display:grid;gap:2px;justify-items:start;align-content:start;min-height:240px;padding:10px;border-radius:10px;background:radial-gradient(#DCE3EC 1px,transparent 1.2px) 0 0/16px 16px}
.scripts-row{display:flex;gap:18px;flex-wrap:wrap;align-items:flex-start}
.blk{--c:var(--motion);display:inline-flex;align-items:center;gap:6px;background:var(--c);color:#fff;border-radius:6px;padding:7px 11px;font-weight:600;font-size:15px;line-height:1.2;border:0;box-shadow:inset 0 -2px 0 rgba(0,0,0,.15);white-space:nowrap}
.blk.hat{border-radius:18px 18px 6px 6px;padding-top:12px}
.blk.motion{--c:var(--motion)} .blk.looks{--c:var(--looks)} .blk.events{--c:var(--events);color:#2b2100} .blk.control{--c:var(--control);color:#2b1a00}
.blk .val{background:#fff;color:var(--ink);border-radius:999px;padding:1px 9px;font-family:var(--mono);font-size:14px;min-width:28px;text-align:center}
.blk input.val{border:2px dashed var(--ink);width:62px;outline:none;font-weight:700}
.blk input.val:focus{border-color:var(--ink)}
.blk.events .val,.blk.control .val{color:var(--ink)}
.blk .tools{display:inline-flex;gap:3px;margin-left:6px}
.blk .tools button{border:0;background:rgba(0,0,0,.18);color:inherit;border-radius:5px;width:24px;height:24px;font-size:13px;line-height:1;padding:0}
.cblk{display:grid;justify-items:start}
.cblk>.blk{border-radius:6px 6px 0 0}
.cbody{display:grid;gap:2px;justify-items:start;border-left:16px solid var(--c);padding:3px 0 3px 2px;min-height:30px;min-width:120px}
.cfoot{height:14px;width:90px;background:var(--c);border-radius:0 0 6px 6px}
.grab{cursor:grab;touch-action:none}
.dragging,.dragging *{cursor:grabbing!important;user-select:none}
.dragghost{position:fixed;z-index:100;pointer-events:none;opacity:.9;filter:drop-shadow(0 6px 10px rgba(0,0,0,.25));margin:0}
.dragsrc{opacity:.3}
.dropline{position:fixed;z-index:99;width:140px;height:5px;border-radius:3px;background:var(--ink);pointer-events:none}
.palette.trash{outline:3px dashed var(--warn);outline-offset:4px;border-radius:8px}
.tipbox{margin-top:10px;display:grid;gap:2px;background:#FFF4D6;color:#5C4300;border-radius:12px;padding:10px 14px;font-size:15px}
.tipbox strong{font-family:var(--display);font-size:17px}
.slot{border:2px dashed var(--line);background:transparent;color:var(--muted);border-radius:6px;padding:3px 10px;font-size:13px}
.slot.active{border-color:var(--accent);color:var(--accent);background:var(--accent-soft);font-weight:600}
.flagico{width:18px;height:18px;vertical-align:-3px}

/* ---------- escenario ---------- */
.stagebox{display:grid;gap:8px}
.stagectl{display:flex;gap:8px;align-items:center}
.stagectl button{border:2px solid var(--line);background:var(--paper);border-radius:10px;width:46px;height:40px;display:grid;place-items:center;padding:0}
.stagectl button:hover{border-color:var(--accent)}
.stagectl .readout{margin-left:auto;font-family:var(--mono);font-size:13px;color:var(--muted)}
.stage{width:100%;aspect-ratio:4/3;border:2px solid var(--line);border-radius:10px;background:#fff;overflow:hidden;display:block;max-width:100%}
.stage.clickable{cursor:crosshair}
.stage .spr{cursor:pointer}

/* ---------- opción múltiple / números ---------- */
.options{display:grid;gap:10px}
.opt{display:flex;gap:12px;align-items:center;text-align:left;border:2px solid var(--line);background:var(--paper);border-radius:12px;padding:12px 14px;color:var(--ink);font-size:17px}
.opt .letter{font-family:var(--display);font-weight:800;font-size:20px;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--ground);flex:none}
.opt[aria-pressed=true]{border-color:var(--accent);background:var(--accent-soft)}
.opt[aria-pressed=true] .letter{background:var(--accent);color:#fff}
.nums{display:flex;gap:14px;flex-wrap:wrap;align-items:end}
.nums label{display:grid;gap:4px;font-weight:600}
.nums input{font-family:var(--mono);font-size:24px;width:130px;padding:8px 10px;border:2px solid var(--line);border-radius:10px}
.checks{display:grid;gap:6px;font-size:15px;color:var(--muted)}
.checks li{margin-left:18px}

/* ---------- interfaz (4°) ---------- */
.mock{display:grid;min-width:720px;grid-template-columns:52px 140px minmax(0,1fr) minmax(220px,280px);grid-template-rows:36px 34px 1fr;height:470px;border:2px solid var(--line);border-radius:12px;overflow:hidden;background:#fff;font-size:13px}
.mock button{border:0;margin:0;padding:0;background:none;color:inherit;font:inherit;text-align:left;position:relative}
.mock button:hover{outline:3px solid rgba(45,68,181,.35);outline-offset:-3px;z-index:2}
.mock .picked{outline:3px solid var(--accent)!important;outline-offset:-3px;z-index:3}
.m-menu{grid-column:1/-1;background:#5C6BC0;color:#fff;display:flex;gap:18px;align-items:center;padding:0 14px!important;font-weight:600}
.m-tabs{grid-column:1/4;display:flex;background:#EEF1F8;border-bottom:1px solid var(--line)}
.m-tab{padding:0 16px!important;display:flex;align-items:center;gap:6px;border-right:1px solid var(--line)!important}
.m-tab.on{background:#fff}
.m-ctl{grid-column:4;display:flex!important;gap:10px;align-items:center;padding:0 10px!important;background:#EEF1F8;border-bottom:1px solid var(--line)}
.m-ctl button{width:32px;height:28px;display:grid;place-items:center;border-radius:6px}
.m-cats{background:#fff;border-right:1px solid var(--line);display:grid;align-content:start;gap:10px;padding:10px 0!important;justify-items:center;font-size:10px}
.m-cats i{display:block;width:20px;height:20px;border-radius:50%}
.m-pal{background:#F9FAFC;border-right:1px solid var(--line);padding:10px!important;display:grid;align-content:start;gap:7px}
.m-pal span{display:block;height:22px;border-radius:5px}
.m-code{background:repeating-linear-gradient(0deg,#fff 0 23px,#F1F4F9 23px 24px);padding:20px!important;display:block}
.m-right{grid-column:4;display:grid;grid-template-rows:auto 1fr;border-left:1px solid var(--line);min-height:0}
.m-stage{border-bottom:1px solid var(--line);aspect-ratio:4/3;display:block}
.m-sprites{display:grid;grid-template-columns:1fr 64px;min-height:0}
.m-spr{padding:8px!important;display:flex!important;gap:8px;align-items:flex-start;background:#F4F6FA}
.m-spr span{width:52px;height:52px;border-radius:8px;border:2px solid var(--accent);background:#fff;display:grid;place-items:center}
.m-bd{border-left:1px solid var(--line)!important;display:grid!important;place-items:end center;padding-bottom:12px!important;background:#F4F6FA}
.m-bd span{width:40px;height:40px;border-radius:50%;background:#5C6BC0;display:grid;place-items:center}
.asks{display:grid;gap:8px}
.ask{display:flex;gap:10px;align-items:center;padding:8px 12px;border-radius:10px;background:var(--ground);font-weight:500}
.ask.now{background:var(--accent-soft);color:var(--accent);font-weight:600}
.ask .st{font-family:var(--mono);font-size:13px;margin-left:auto;color:var(--muted)}

/* ---------- capas ---------- */
.overlay{position:fixed;inset:0;background:rgba(24,34,47,.82);display:grid;place-items:center;z-index:50;padding:16px}
.overlay .card{background:var(--paper);border-radius:18px;padding:28px;max-width:480px;width:100%;display:grid;gap:14px;text-align:center}
.overlay h2{font-size:32px}
.overlay .card.lock h2{color:var(--warn)}
.overlay input{font:inherit;font-size:20px;padding:10px;border:2px solid var(--line);border-radius:10px;text-align:center}
.result{display:grid;place-items:center;min-height:100%;padding:16px}
.rcard{background:var(--paper);border-radius:20px;padding:22px 26px;max-width:1080px;width:100%;display:grid;gap:16px;user-select:text;-webkit-user-select:text}
.rhead{display:flex;gap:20px;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;border-bottom:2px solid var(--line);padding-bottom:14px}
.rhead h2{font-size:34px;margin-top:4px}
.rmeta{color:var(--muted);font-size:15px;margin-top:4px}
.rscore{text-align:right}
.rscore #resAciertos{color:var(--muted);font-size:15px}
.rbody{display:grid;grid-template-columns:minmax(220px,300px) minmax(0,1fr);gap:18px;align-items:start}
@media (max-width:760px){.rbody{grid-template-columns:1fr}}
.rexits{border-radius:14px;padding:14px 16px;display:grid;gap:4px}
.rexits.clean{background:#E3F4EA;color:#14532D}
.rexits.dirty{background:#FDE7D7;color:#7C2D12}
.rexits .n{font-family:var(--display);font-size:52px;font-weight:800;line-height:1}
.rexits .lbl{font-weight:600}
.rexits ul{margin:6px 0 0;padding-left:18px;font-family:var(--mono);font-size:13px}
.rtable-wrap{overflow-x:auto}
.rtable{width:100%;border-collapse:collapse;font-size:15px}
.rtable th{text-align:left;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600;padding:4px 8px;border-bottom:1px solid var(--line)}
.rtable td{padding:6px 8px;border-bottom:1px solid var(--ground)}
.rtable td.pts{font-family:var(--mono);font-weight:700;text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
.rtable td.pts.full{color:var(--ok)} .rtable td.pts.zero{color:var(--warn)}
.shot{display:flex;gap:14px;align-items:center;background:var(--accent-soft);color:var(--accent);border-radius:14px;padding:12px 16px;font-size:16px}
.shot strong{color:var(--ink)}
kbd{font-family:var(--mono);font-size:13px;background:var(--paper);border:1px solid var(--line);border-bottom-width:3px;border-radius:6px;padding:1px 6px;color:var(--ink)}
.rteacher{display:flex;gap:10px;align-items:center;justify-content:flex-end;font-size:13px;color:var(--muted);flex-wrap:wrap}
.rteacher input{font:inherit;padding:4px 8px;border:1px solid var(--line);border-radius:6px;width:110px}
.review{display:grid;gap:14px;border-top:2px solid var(--line);padding-top:14px}
.review h3{font-size:24px}
.rv-note{margin:-8px 0 0;color:var(--muted);font-size:14px}
.rv-item{border:1px solid var(--line);border-radius:14px;padding:12px 14px;display:grid;gap:10px}
.rv-head{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
.rv-head .pts{font-family:var(--mono);font-weight:700}
.rv-head .pts.full{color:var(--ok)} .rv-head .pts.zero{color:var(--warn)}
.rv-cols{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media (max-width:760px){.rv-cols{grid-template-columns:1fr}}
.rv-col{min-width:0;overflow-x:auto}
.rv-script{min-height:0!important;padding:6px;transform-origin:top left}
.rv-script .blk{font-size:13px;padding:5px 9px}
.rv-empty{color:var(--muted);font-size:14px}
.rv-checks{margin:0;padding-left:0;list-style:none;display:grid;gap:3px;font-size:14px}
.rv-checks .ok{color:var(--ok)} .rv-checks .no{color:var(--warn)}
.linkbtn{border:0;background:none;color:var(--muted);text-decoration:underline;font-size:13px;padding:0}
.result .card{background:var(--paper);border-radius:20px;padding:32px;max-width:520px;width:100%;display:grid;gap:14px;text-align:center}
.score{font-family:var(--display);font-size:84px;font-weight:800;color:var(--accent);line-height:1}
.score small{font-size:30px;color:var(--muted)}
.sendstate{font-size:15px;color:var(--muted)}
.sendstate.ok{color:var(--ok)} .sendstate.bad{color:var(--warn)}
.teachercode{font-family:var(--mono);font-size:13px;background:var(--ground);border-radius:10px;padding:10px;text-align:left;white-space:pre-wrap;user-select:text;-webkit-user-select:text}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>

<!-- ========== INICIO ========== -->
<section class="start" id="startView">
  <div class="start-card">
    <div>
      <div class="eyebrow">Computación · I Bloque · Programación con Scratch</div>
      <h1>Examen práctico de 6°</h1>
    </div>
    <div id="newForm" class="start-card" style="padding:0;box-shadow:none">
      <div class="field">
        <label for="nombre">Escribe tu nombre empezando por tu apellido</label>
        <input type="text" id="nombre" autocomplete="off" placeholder="Ejemplo: López Pérez Ana">
      </div>
      <div class="field">
        <label>Tu grupo</label>
        <div class="groups" id="grupos" role="radiogroup" aria-label="Grupo">
          <label class="gopt"><input type="radio" name="grupo" value="A"><span>A</span></label>
          <label class="gopt"><input type="radio" name="grupo" value="B"><span>B</span></label>
        </div>
      </div>
      <div class="rules">
        <strong>Antes de empezar</strong>
        <ul>
          <li>El examen se abre en pantalla completa. Si sales o cambias de pestaña, queda registrado.</li>
          <li>En este examen, el objeto (sprite) es un robot. En varios reactivos vas a armar programas y probarlos con la bandera verde las veces que quieras.</li>
          <li>Al terminar, toma una captura de pantalla de tu resultado y súbela a Classroom.</li>
          <li>Cuando pases al siguiente reactivo, ya no podrás regresar.</li>
        </ul>
      </div>
      <div class="err" id="startErr"></div>
      <noscript><div class="jserr">Este navegador tiene JavaScript desactivado. Abre el examen en Google Chrome.</div></noscript>

      <button class="btn" id="btnStart">Comenzar examen</button>
    </div>
    <div id="resumeForm" hidden style="display:grid;gap:14px">
      <p style="margin:0">Hay un examen sin terminar de <strong id="resumeName"></strong>. Para continuarlo o empezar de nuevo, tu maestra debe escribir su código.</p>
      <input type="text" id="resumeCode" autocomplete="off" placeholder="Código de la maestra" style="font:inherit;font-size:19px;padding:12px;border:2px solid var(--line);border-radius:12px">
      <div class="err" id="resumeErr"></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button class="btn" id="btnResume">Continuar examen</button>
        <button class="btn ghost" id="btnRestart">Empezar de nuevo</button>
      </div>
    </div>
  </div>
</section>

<!-- ========== EXAMEN ========== -->
<section class="exam" id="examView" hidden>
  <header class="topbar">
    <div class="who" id="who"></div>
    <div class="dots" id="dots" aria-label="Avance"></div>
  </header>
  <main class="main" id="itemHost"></main>
  <footer class="bottombar">
    <span class="note" id="footNote"></span>
    <button class="btn" id="btnNext">Siguiente</button>
  </footer>
</section>

<!-- ========== RESULTADO ========== -->
<section class="result" id="resultView" hidden>
  <div class="rcard">
    <div class="rhead">
      <div>
        <div class="eyebrow">Computación · Examen práctico de Scratch · I Bloque</div>
        <h2 id="resName"></h2>
        <div class="rmeta" id="resMeta"></div>
      </div>
      <div class="rscore"><div class="score" id="resScore"></div><div id="resAciertos"></div></div>
    </div>
    <div class="rbody">
      <div class="rexits" id="resExits"></div>
      <div class="rtable-wrap"><table class="rtable" id="resTable"></table></div>
    </div>
    <div class="shot">
      <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
