  wrap.style.setProperty("--c", getComputedStyle(document.documentElement).getPropertyValue("--" + d.cat));
  const body = el("div", { class: "cbody" });
  b.body.forEach((ch, i) => body.append(renderBlock(ch, mode, { ...ctx, parent: b.body, index: i })));
