const FLAG_SVG = '<svg class="flagico" viewBox="0 0 20 20" aria-label="bandera verde"><path d="M4 2v17" stroke="#3a7d1f" stroke-width="2" stroke-linecap="round"/><path d="M5 3c4-2 6 2 11 0v8c-5 2-7-2-11 0z" fill="#4CBF56" stroke="#3a7d1f" stroke-width="1.2"/></svg>';
const STOP_SVG = '<svg class="flagico" viewBox="0 0 20 20" aria-label="detener"><path d="M7 2h6l5 5v6l-5 5H7l-5-5V7z" fill="#E6503C" stroke="#b53a2a"/></svg>';

/* ---------------------- bloques ---------------------- */
const DEFS = {
  whenflag:   { cat: "events", hat: true, parts: ["al hacer clic en", "FLAG"] },
  whenkey:    { cat: "events", hat: true, parts: ["al presionar tecla", "@espacio"] },
  whenclicked:{ cat: "events", hat: true, parts: ["al hacer clic en este objeto"] },
