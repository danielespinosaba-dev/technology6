  bounce:     { cat: "motion", parts: ["rebotar si toca un borde"] },
  rotlr:      { cat: "motion", parts: ["fijar estilo de rotación a", "@izquierda-derecha"] },
  sayfor:     { cat: "looks", parts: ["decir", 0, "por", 1, "segundos"] },
  nextcostume:{ cat: "looks", parts: ["siguiente disfraz"] },
  coloreffect:{ cat: "looks", parts: ["cambiar efecto", "@color", "por", 0] },
  changesize: { cat: "looks", parts: ["cambiar tamaño por", 0] },
  setsize:    { cat: "looks", parts: ["fijar tamaño a", 0, "%"] },
  wait:       { cat: "control", parts: ["esperar", 0, "segundos"] },
