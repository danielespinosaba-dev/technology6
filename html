    scripts: [[B("whenflag"), B("goto", 0, 0), B("changex", 50), B("changey", -100), B("changex", 50)]],
    inputs: [{ label: "x", answer: 100 }, { label: "y", answer: -100 }] },
  { id: "rebotar", tema: "«por siempre» + «rebotar si toca un borde»", type: "build",
    prompt: "Arma un programa que, al hacer clic en la bandera verde, haga que el objeto avance sin detenerse y rebote cada vez que toca un borde del escenario.",
    hint: "Segundo punto: al regresar hacia la izquierda, el objeto no debe quedar de cabeza.",
    palette: [B("whenflag"), C("forever", [], []), B("move", 10), B("bounce"), B("rotlr"), B("turn", 15), B("sayfor", "¡Hola!", 2)],
    stage: { sprite: { x: 0, y: 0 } },
    solution: [[B("whenflag"), B("rotlr"), C("forever", [], [B("move", 10), B("bounce")])]],
