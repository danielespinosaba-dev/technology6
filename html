      { desc: "Usa el estilo de rotación izquierda-derecha", fn: r => r.m.bounces >= 1 && r.m.dist > 300 && r.rot === "lr", tips: ["Observa al robot cuando regresa. ¿Cómo queda su cabeza?", "La forma en que gira un objeto se puede limitar. Busca entre los bloques de Movimiento."] }
    ] },
  { id: "direccion", tema: "Bloque «apuntar en dirección»", type: "build",
    prompt: "El objeto debe subir hasta la estrella, pero con «apuntar en dirección (90)» avanza hacia la derecha. Cambia el número de la dirección para que llegue a la estrella.",
    hint: "Escribe el número en el espacio con borde punteado y prueba con la bandera verde.",
    start: [[B("whenflag"), B("goto", 0, -100), E(B("pointdir", 90), 0), B("move", 200)]],
    stage: { sprite: { x: 0, y: -100 }, markers: [{ x: 0, y: 100, kind: "star" }] }, readout: true,
    solution: [[B("whenflag"), B("goto", 0, -100), B("pointdir", 0), B("move", 200)]],
    checks: [{ desc: "Llega a la estrella (x = 0, y = 100)", fn: r => Math.abs(r.x) <= 3 && Math.abs(r.y - 100) <= 3, tips: ["En Scratch, 90 apunta a la derecha. Prueba otro número y observa hacia dónde gira el robot.", "Si 90 es derecha y 180 es abajo, ¿qué número apuntaría hacia arriba?"] }] },
  { id: "tamano", tema: "«fijar tamaño» y «cambiar tamaño»", type: "number",
    prompt: "Al terminar este programa, ¿qué tamaño (%) tiene el objeto?",
    scripts: [[B("whenflag"), B("setsize", 100), C("repeat", [3], [B("changesize", 20)]), B("changesize", -10)]],
    inputs: [{ label: "Tamaño (%)", answer: 150 }] },
  { id: "meta", tema: "Programa completo con «repetir»", type: "build",
    prompt: "Arma un programa que, al hacer clic en la bandera verde, use «repetir» para que el objeto avance desde x = −200 hasta la meta en x = 0, cambiando de disfraz en cada repetición.",
    hint: "Puedes cambiar los números de los bloques. Arriba del escenario puedes ver el valor de x.",
    palette: [B("whenflag"), B("goto", -200, 0), C("repeat", [5], []), C("forever", [], []), B("move", 10), B("nextcostume"), B("wait", 0.1), B("turn", 15)],
    stage: { sprite: { x: -200, y: 0 }, markers: [{ x: 0, y: 0, kind: "goal" }] }, readout: true,
    solution: [[B("whenflag"), B("goto", -200, 0), C("repeat", [20], [B("move", 10), B("nextcostume")])]],
    checks: [
      { desc: "Se detiene en la meta (x = 0)", fn: r => Math.abs(r.x) <= 4 && Math.abs(r.y) <= 4, tips: ["Mira el valor de x cuando el robot se detiene: ¿se pasó, le faltó o no se movió?", "La distancia total es: pasos en cada vuelta × número de vueltas."] },
      { desc: "Llega a la meta con «mover» y «siguiente disfraz» dentro de «repetir»", fn: (r, sc) => Math.abs(r.x) <= 4 && Math.abs(r.y) <= 4 && r.m.costumeChanges >= 3 && hasInside(sc, "repeat", "nextcostume") && hasInside(sc, "repeat", "move"), tips: ["¿El robot mueve las piernas en cada paso o solo una vez?", "Los bloques que deben repetirse tienen que quedar adentro del bloque «repetir»."] }
